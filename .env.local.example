# ── Google Calendar (required for booking sync) ─────────────────────
# The ID of your Euphoria bookings calendar
# Find it: Google Calendar → Settings → [your calendar] → "Calendar ID"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Service account credentials from Google Cloud Console
# (the email looks like: euphoria-bookings@your-project.iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the FULL private key from your service account JSON key file.
# Keep the -----BEGIN/END----- lines. Replace real newlines with \n
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# ── Google Maps Places API ──────────────────────────────────────────
# Replace with your real key to enable venue autocomplete
NEXT_PUBLIC_GOOGLE_MAPS_KEY=YOUR_KEY_HERE

# ── Resend (email notifications) ────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Site URL (used in sitemap & metadata) ───────────────────────────
NEXT_PUBLIC_SITE_URL=https://euphoria.events
